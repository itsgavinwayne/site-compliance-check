{
  "name": "site-compliance-check",
  "version": "0.1.0",
  "description": "Pre-launch website compliance scanner (privacy, cookies, disclosures, CN filing, accessibility). Not legal advice.",
  "type": "module",
  "bin": { "scc": "bin/scc.js" },
  "engines": { "node": ">=20" },
  "scripts": {
