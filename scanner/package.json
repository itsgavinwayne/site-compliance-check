    "checklist": "node ../scripts/gen-checklist.js",
    "checklist:check": "node ../scripts/gen-checklist.js --check"
  },
  "license": "MIT",
  "dependencies": {
    "@axe-core/playwright": "^4.11.0",
    "playwright": "^1.56.0",
    "yaml": "^2.8.0"
  }
}
